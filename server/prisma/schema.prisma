generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Better Auth models ──────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("agent") @db.VarChar(50)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  tickets       Ticket[]         @relation("AssignedTickets")
  ticketReplies TicketReply[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Application models ──────────────────────────────────────────────

model Ticket {
  id                        Int           @id @default(autoincrement())
  subject                   String        @db.VarChar(500)
  body                      String
  senderEmail               String        @db.VarChar(255) @map("sender_email")
  senderName                String        @db.VarChar(255) @map("sender_name")
  status                    String        @default("open") @db.VarChar(50)
  category                  String?       @db.VarChar(50)
  assignedTo                String?       @map("assigned_to")
  classificationConfidence  Decimal?      @db.Decimal(3, 2) @map("classification_confidence")
  createdAt                 DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime?     @default(now()) @map("updated_at") @db.Timestamp(6)

  assignedUser              User?         @relation("AssignedTickets", fields: [assignedTo], references: [id], onUpdate: NoAction)
  replies                   TicketReply[]

  @@index([assignedTo], map: "idx_tickets_assigned_to")
  @@index([category], map: "idx_tickets_category")
  @@index([createdAt], map: "idx_tickets_created_at")
  @@index([status], map: "idx_tickets_status")
  @@map("ticket")
}

model TicketReply {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    Int       @map("ticket_id")
  agentId     String?   @map("agent_id")
  senderType  String    @default("agent") @db.VarChar(50) @map("sender_type")
  message     String
  isSuggested Boolean?  @default(false) @map("is_suggested")
  sentAt      DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  agent       User?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId], map: "idx_ticket_replies_ticket_id")
  @@map("ticket_reply")
}

model KnowledgeBase {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String    @db.VarChar(255)
  content   String
  tags      String[]  @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  @@map("knowledge_base")
}
